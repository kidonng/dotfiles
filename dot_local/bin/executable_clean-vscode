#!/usr/bin/env nix
#!nix run nixpkgs#nushell
# vim: set ft=nu :
def parse-target-path [uri: string] {
    if ($uri | str starts-with "file://") {
        $uri | str replace "file://" "" | url decode
    } else if ($uri | str starts-with "vscode-userdata:") {
        # `vscode-userdata:` URIs carry the absolute file path after the scheme
        # e.g. vscode-userdata:/Users/me/.../Code/User/settings.json
        $uri | str replace "vscode-userdata:" "" | url decode
    } else {
        null
    }
}

def clean-storage [
    dir: path
    config_file: string
    uri_keys: list<string>
    --clean-remote
] {
    if not ($dir | path exists) { return 0 }

    let targets = (
        ls $dir
        | where type == dir
        | where { |folder|
            let cfg = ($folder.name | path join $config_file)
            if not ($cfg | path exists) {
                true
            } else {
                let data = (try { open $cfg } catch { {} })
                let uri = ($uri_keys | each { |k| $data | get -o $k } | compact | first | default "")

                if ($clean_remote and ($uri | str starts-with "vscode-remote://")) {
                    true
                } else {
                    let target_path = (parse-target-path $uri)
                    ($target_path != null) and (not ($target_path | path exists))
                }
            }
        }
        | get name
    )

    $targets | each { |it| rm -rf $it }
    $targets | length
}

let base_path = ("~/Library/Application Support/Code/User" | path expand)

let cleaned_ws = (clean-storage ($base_path | path join "workspaceStorage") "workspace.json" ["folder", "workspace"] --clean-remote)
let cleaned_hist = (clean-storage ($base_path | path join "History") "entries.json" ["resource"])

print $"Cleanup complete!"
print $"- Cleaned ($cleaned_ws) workspaces"
print $"- Cleaned ($cleaned_hist) history entries"
